# Окружения: local (разработка), dev (мини-ПК + cloudflared + тест-бот),
# prod (VPS, статический IP — отдельный docker-compose.prod.yml).
# Для локальной разработки оставьте local/development.
ENV=development
COMPOSE_PROFILES=local
# Отдельно выбирает nginx/nginx-*.conf для local/dev compose. Dev-туннелю нужен
# nginx-development.conf, иначе admin-dev попадёт в mini app fallback.
NGINX_ENV=development

# Нужен только для профиля dev (туннель мини-ПК). Для local оставьте пустым.
CLOUDFLARE_TUNNEL_TOKEN=
TG_TOKEN=

# Accept Telegram init data without verifying its signature.
# Local development with the browser mock only — with this on, anyone can
# claim to be any user. Leave it off everywhere else.
ALLOW_UNSIGNED_INIT_DATA=false
TG_BOT_USERNAME=
# Public origin (no trailing slash), e.g. https://split-the-bill.uz — used to
# build public image URLs Telegram fetches for the prepared invite message and
# for the pictures of rich broadcasts, and the URL the bot's /start button
# opens (the Mini App).
PUBLIC_BASE_URL=
# Shared secret echoed back by Telegram in the X-Telegram-Bot-Api-Secret-Token
# header so we can trust the /api/telegram/webhook calls. Set the same value
# when calling setWebhook (secret_token=...). Leave empty to skip the check.
TG_WEBHOOK_SECRET=
# How many Telegram updates the bot handles at once, each in a thread of its
# own; one chat's updates still go one at a time, in order.
BOT_UPDATE_WORKERS=4

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Dev only: "1" installs a fake window.Telegram.WebApp so the frontend
# works in a regular browser without going through Telegram.
# Has no effect in production builds (the code is tree-shaken).
NEXT_PUBLIC_ENABLE_TG_MOCK=1

OPENAI_API_KEY=
# Optional: the model that reads receipts until one is picked in the admin panel.
OPENAI_RECEIPT_MODEL=gpt-6-luna
# Optional: the model that labels receipt lines (burger, cappuccino…) and names
# the place a bill was at, for analytics, until one is picked in the admin panel.
OPENAI_LABEL_MODEL=gpt-6-luna
GOOGLE_APPLICATION_CREDENTIALS=

PAYMENT_ENC_KEY=

# Soliq QR import — HMAC signing key the fiscal check API (new-ofd.soliq.uz)
# expects on X-Signature. Required for the QR receipt import; there is no dev
# fallback. Value is the signing key from Soliq's frontend bundle.
SOLIQ_API_SECRET=

# Product analytics (PostHog). Leave the key empty to disable analytics
# entirely — init is a no-op without it. Host defaults to the PostHog EU cloud.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Session replay is disabled by default because bills contain personal/payment
# data. Set to "0" only after an explicit privacy review; text stays masked.
NEXT_PUBLIC_POSTHOG_DISABLE_REPLAY=1
# The backend sends what only it sees — Pro payments, the bot's chat — to the
# same project, so set the same project key here. Empty: the backend sends nothing.
# On prod the deploy passes the repository's POSTHOG_KEY and POSTHOG_HOST variables.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Scheduler -------------------------------------------------------------
# Payment reminders for participants who owe money on a fully-allocated bill.
REMINDERS_ENABLED=1
# Growing cadence in minutes; the last value repeats.
REMINDER_INTERVALS_MIN=15,30,60,180
# Do-not-disturb window in REMINDER_TZ (wraps midnight).
REMINDER_QUIET_HOURS=23:00-09:00
REMINDER_TZ=Asia/Tashkent
# An app from my.telegram.org for the sender accounts — the Telegram user
# accounts that deliver an owner's reminder when the person blocked the bot.
# The accounts themselves are logged in from the admin panel («Рассыльщики»).
TG_API_ID=
TG_API_HASH=
# Telegram remembers a photo by the URL it fetched it from, so redrawing the
# bot's welcome or guide pictures (tools/bot-media) under the same names keeps
# sending the old ones. Bump to publish.
BOT_MEDIA_VERSION=1
# A settled bill closes itself once it has been quiet for this long. The clock
# runs from the last thing that happened to a payer — a confirmation, or a change
# to what they owe — so an edit after everyone has paid restarts it.
AUTO_CLOSE_GRACE_SECONDS=900
AUTO_CLOSE_TZ=Asia/Tashkent
# Receipt photos older than this are deleted from disk once a bill is settled
# or removed. Rows stay; only the files go.
RECEIPT_FILES_TTL_DAYS=30

# --- Admin panel (admin.split-the-bill.uz) ---------------------------------
# A single operator account; there is no admin user table.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs the admin session cookie. Any long random string.
ADMIN_JWT_SECRET=
